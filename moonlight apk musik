    @JavascriptInterface public void savePng(String b64, String name) {
      try {
        byte[] d = Base64.decode(b64, Base64.DEFAULT);
        if (Build.VERSION.SDK_INT >= 29) {
          ContentValues cv = new ContentValues();
          cv.put("_display_name", name); cv.put("mime_type", "image/png"); cv.put("relative_path", "Pictures/MoonLight");
          Uri u = getContentResolver().insert(MediaStore.Images.Media.EXTERNAL_CONTENT_URI, cv);
          OutputStream o = getContentResolver().openOutputStream(u); o.write(d); o.close();
        } else toast("Butuh Android 10+ untuk simpan poster");
      } catch (Exception e) { toast("Gagal menyimpan poster"); }
    }
    @JavascriptInterface public void http(final String id, final String url) {
      new Thread(new Runnable() { public void run() {
        String res = "";
        try {
          java.net.HttpURLConnection c = (java.net.HttpURLConnection) new java.net.URL(url).openConnection();
          c.setConnectTimeout(8000); c.setReadTimeout(8000); c.setRequestProperty("User-Agent", "MoonLight/1.0");
          java.io.InputStream in = c.getInputStream(); java.io.ByteArrayOutputStream bo = new java.io.ByteArrayOutputStream();
          byte[] b = new byte[4096]; int n; while ((n = in.read(b)) > 0) bo.write(b, 0, n); in.close();
          res = Base64.encodeToString(bo.toByteArray(), Base64.NO_WRAP);
        } catch (Exception e) {}
        final String r = res;
        runOnUiThread(new Runnable() { public void run() { web.evaluateJavascript("onHttp('" + id + "','" + r + "')", null); } });
      } }).start();
    }
  }

  @Override protected void onCreate(Bundle b) {
    super.onCreate(b);
    if (Build.VERSION.SDK_INT >= 33 && checkSelfPermission("android.permission.POST_NOTIFICATIONS") != 0) requestPermissions(new String[]{"android.permission.POST_NOTIFICATIONS"}, 1);
    sp = getSharedPreferences("m", 0);
    root = new FrameLayout(this); root.setFitsSystemWindows(true); root.setBackgroundColor(0xFF5D5D62);
    web = new WebView(this) {
      @Override protected void onWindowVisibilityChanged(int v) {
        super.onWindowVisibilityChanged(View.VISIBLE); // tetap play saat app di background
      }
    };
    web.setBackgroundColor(0);
    WebSettings ws = web.getSettings();
    ws.setJavaScriptEnabled(true); ws.setDomStorageEnabled(true); ws.setMediaPlaybackRequiresUserGesture(false);
    web.setWebChromeClient(new WebChromeClient());
    web.setWebViewClient(new WebViewClient());
    web.addJavascriptInterface(new Bridge(), "A");
    root.addView(web, new FrameLayout.LayoutParams(-1, -1));
    setContentView(root);
    web.loadDataWithBaseURL("https://" + getPackageName() + "/", HTML, "text/html", "utf-8", null);

    IntentFilter f = new IntentFilter(); f.addAction("mc.PP"); f.addAction("mc.NEXT"); f.addAction("mc.PREV"); f.addAction("mc.SEEK"); f.addAction("mc.SHUF"); f.addAction("mc.REP");
    try {
      if (Build.VERSION.SDK_INT >= 33)
        Context.class.getMethod("registerReceiver", BroadcastReceiver.class, IntentFilter.class, int.class).invoke(this, rc, f, 4);
      else registerReceiver(rc, f);
    } catch (Exception e) { registerReceiver(rc, f); }
  }

  BroadcastReceiver rc = new BroadcastReceiver() {
    public void onReceive(Context c, Intent i) {
      String a = i.getAction();
      if ("mc.SEEK".equals(a)) { web.evaluateJavascript("nativeSeek(" + i.getLongExtra("pos", 0) + ")", null); return; }
      String cmd = "mc.PP".equals(a) ? "PP" : "mc.NEXT".equals(a) ? "NEXT" : "mc.SHUF".equals(a) ? "SHUF" : "mc.REP".equals(a) ? "REP" : "PREV";
      web.evaluateJavascript("nativeCmd('" + cmd + "')", null);
    }
  };

  @Override public void onBackPressed() {
    web.evaluateJavascript("goBack()", new ValueCallback<String>() {
      public void onReceiveValue(String v) { if (!"true".equals(v)) moveTaskToBack(true); }
    });
  }
  @Override protected void onPause() { super.onPause(); web.resumeTimers(); }
  @Override protected void onStart() {
    super.onStart(); fg = true;
    try { if (MusicService.on) startService(new Intent(this, MusicService.class).putExtra("isl", 0)); } catch (Exception e) {}
  }
  @Override protected void onStop() {
    super.onStop(); web.resumeTimers(); fg = false;
    try { if (MusicService.on) startService(new Intent(this, MusicService.class).putExtra("isl", 1)); } catch (Exception e) {}
  }
  @Override protected void onDestroy() {
    super.onDestroy();
    try { unregisterReceiver(rc); } catch (Exception e) {}
    if (!isChangingConfigurations()) {
      try { stopService(new Intent(this, MusicService.class)); MusicWidget.reset(this); } catch (Exception e) {}
    }
  }

